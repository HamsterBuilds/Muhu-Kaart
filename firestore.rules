rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/groups/{groupId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /groups/{groupId}/members/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }

    match /points/{pointId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /points/{pointId}/visits/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == userId;
    }

    match /tracks/{trackId} {
      // Coverage uses a deterministic per-user document. The explicit ID
      // check also lets the first merge write pass when the document does not
      // exist yet; resource.data is unavailable during a create.
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid || trackId == 'coverage-' + request.auth.uid
      );
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /tracks/{trackId}/points/{trackPointId} {
      allow read: if signedIn() && (
        get(/databases/$(database)/documents/tracks/$(trackId)).data.userId == request.auth.uid
        || trackId == 'coverage-' + request.auth.uid
      );
      allow create, update: if signedIn() && (
        get(/databases/$(database)/documents/tracks/$(trackId)).data.userId == request.auth.uid
        || trackId == 'coverage-' + request.auth.uid
      );
      allow delete: if signedIn() && get(
        /databases/$(database)/documents/tracks/$(trackId)
      ).data.userId == request.auth.uid;
    }
  }
}
